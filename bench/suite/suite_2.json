{
 "name": "tnkit-bench-suite-2-tier1",
 "repeats": 3,
 "settings": "settings_suite2.json",
 "spread_rerun": {
  "ratio": 1.5,
  "extra": 2
 },
 "envs": {
  "main": {
   "site": "${TNBENCH_SITE_MAIN}"
  },
  "qtea": {
   "site": "${TNBENCH_SITE_QTEA}"
  },
  "julia": {
   "site": "${TNBENCH_SITE_MAIN}"
  }
 },
 "workloads": {
  "tf_collision": {
   "kind": "collision",
   "N": 160,
   "chis": [
    256
   ],
   "state": "${TNBENCH_DATA}/state_gt0020.000.npz",
   "mpo": "${TNBENCH_DATA}/mpo.npz",
   "dt": 0.05,
   "steps": 6,
   "exclude_first": 1,
   "svd_tol": 1e-08,
   "sv_tol": 0.0001,
   "krylov_m": 80,
   "accuracy": {
    "metric": "max over qubits of |<n_j> - <n_j>(tnkit, same symmetry, rep 1)| after the steps",
    "eps": [
     0.0001
    ]
   },
   "timeout_s": {
    "gpu": 5400
   }
  },
  "xxz_dmrg": {
   "kind": "dmrg",
   "model": "xxz",
   "N": 64,
   "J": 1.0,
   "Jz": 1.0,
   "chis": [
    32,
    64,
    128,
    256
   ],
   "max_sweeps": 20,
   "e_tol": 1e-10,
   "sv_tol": 1e-14,
   "accuracy": {
    "metric": "relative energy error against the reference (chi 512, two libraries agreeing)",
    "eps": [
     1e-06,
     1e-08,
     1e-10
    ]
   },
   "reference": {
    "chi": 512,
    "agree_rel": 1e-10
   },
   "timeout_s": {
    "cpu": 3600,
    "gpu": 3600
   }
  },
  "xx_quench": {
   "kind": "tdvp",
   "model": "xx",
   "N": 32,
   "J": 1.0,
   "Jz": 0.0,
   "dt": 0.05,
   "T": 8.0,
   "chis": [
    32,
    64,
    128,
    256
   ],
   "svd_tol": 1e-12,
   "sv_tol": 1e-06,
   "accuracy": {
    "metric": "max over sites of |<S^z_i(T)> - exact| (free fermions)",
    "eps": [
     0.01,
     0.001,
     0.0001
    ]
   },
   "timeout_s": {
    "cpu": 3600,
    "gpu": 3600
   }
  },
  "xxz_ref": {
   "kind": "dmrg",
   "model": "xxz",
   "N": 64,
   "J": 1.0,
   "Jz": 1.0,
   "chis": [
    512
   ],
   "max_sweeps": 30,
   "e_tol": 1e-12,
   "sv_tol": 1e-14,
   "perf": true,
   "accuracy": {
    "metric": "none: the chi-512 reference energy of xxz_dmrg and heis_throughput",
    "eps": []
   },
   "timeout_s": {
    "cpu": 7200
   }
  },
  "heis_throughput": {
   "kind": "dmrg",
   "model": "xxz",
   "N": 64,
   "J": 1.0,
   "Jz": 1.0,
   "chis": [
    256,
    512,
    1024,
    2048
   ],
   "fixed_sweeps": 3,
