   "e_tol": 1e-10,
   "sv_tol": 1e-14,
   "perf": true,
   "validity": {
    "above_rel": 1e-06,
    "below_rel": 1e-10
   },
   "accuracy": {
    "metric": "none: seconds per sweep (sweeps 2-3) and peak memory; valid if the energy after 3 sweeps is within 1e-6 (relative) above the reference and not 1e-10 below it",
